# Copy to .env for local development. NEVER commit a real .env (Non-Negotiable #10).
# In production, Railway injects DATABASE_URL and REDIS_URL from the Postgres/Redis services.

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
REDIS_URL=redis://localhost:6379/0
HEARTBEAT_INTERVAL_SECONDS=30

# --- AI (§16) ---------------------------------------------------------------
# Leave as "extractive" to run with no API key: headlines and summaries are selected
# from the publishers' own words and labelled as such. Set to "anthropic" and supply a
# key to upgrade — nothing else changes.
AI_PROVIDER=extractive
# ANTHROPIC_API_KEY=            # never commit a real key (Non-Negotiable #10)
AI_MODEL=claude-sonnet-4-6
AI_MIN_IMPORTANCE=0
AI_DAILY_COST_LIMIT_USD=5
AI_MONTHLY_COST_LIMIT_USD=100
